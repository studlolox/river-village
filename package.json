    "check:phase": "npm test && npm run check:names && npm run build && npm run check:budget"
  },
  "dependencies": {
    "three": "^0.170.0"
  },
  "devDependencies": {
    "jsdom": "^25.0.1",
    "vite": "^6.0.0",
    "vitest": "^2.1.8"
  }
}
