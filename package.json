{
  "name": "river-village",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "River Village — single-player three.js farm-life game and mobile PWA",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
